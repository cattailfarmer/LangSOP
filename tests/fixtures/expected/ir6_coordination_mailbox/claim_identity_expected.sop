Subject: IR6 Claim Identity Expected Ledger
Date: 2026-05-26

@ [fixture_plan] docs/fixtures/IR6_Coordination_Mailbox_Fixture_Plan.v1.sop
@ [claim_identity_contract] docs/coordination/IR6_Claim_Identity_And_Work_Boundary_Projection_Contract.v1.sop
@ [activation_boundary] docs/implementation/IR6_Bounded_Coordination_Implementation_Activation_Boundary.v1.sop

& [ExpectedClaimIdentityLedger: IR6CoordinationMailbox] is the expected claim identity ledger
  + [claim_identity_envelope_required] is true
  + [work_boundary_projection_required] is true
  + [required_field] is fixture_case
  + [required_field] is claimant_ref
  + [required_field] is conversation_ref
  + [required_field] is work_packet_ref
  + [required_field] is scope_subject_ref
  + [required_field] is authority_basis_ref
  + [required_field] is authority_notice_ref
  + [required_field] is freshness_state
  + [required_field] is permitted_action_set
  + [required_field] is forbidden_action_set
  + [required_field] is trust_limit

& [ExpectedClaimIdentityCaseSet: IR6CoordinationMailbox] is the per-fixture claim identity ledger
  + [fixture_id] is valid_claim_projection
    + [expected_claim_identity_state] is accepted
    + [expected_boundary_status] is dependency_closed
  + [fixture_id] is compatible_parallel_claims
    + [expected_claim_identity_state] is separated
    + [expected_identity_collapse] is false
  + [fixture_id] is ambiguous_conversation_identity_interrupt
    + [expected_claim_identity_state] is interrupted
    + [expected_identity_clarification_required] is true

  = must: reject claim projections with missing claimant, conversation, work packet, scope, authority basis, or authority notice
  = must: preserve conversation identity independently from claimant identity
