  + [future_file] is src/langsop/manager/authority.py
    + [purpose] is classify source authority, manager planning records, execution evidence, coordination records, operations records, generated projections, graph checkpoints, and carrier context
  + [future_file] is src/langsop/manager/readiness.py
    + [purpose] is recompute ready, blocked, stale, unsafe, contested, and ambiguous readiness states
  + [future_file] is src/langsop/manager/packets.py
    + [purpose] is produce bounded work packet candidates with model routing, proof obligations, completion gates, and stale triggers
  + [future_file] is src/langsop/manager/handoffs.py
    + [purpose] is model manager-to-surface, surface-to-manager, manager-coordination, manager-operations, human override, refusal, and interrupt handoffs
  + [future_file] is src/langsop/manager/faults.py
    + [purpose] is represent stale, unsupported, contested, unclassified, promotion, forbidden-scope, and model-route faults
  + [future_file] is src/langsop/manager/generated_paths.py
    + [purpose] is constrain future generated manager outputs to ignored disposable roots only
  + [future_file] is src/langsop/manager/fixture_runner.py
    + [purpose] is run accepted IR8 fixture records and compare deterministic traces without live effects
  + [future_file] is tests/test_ir8_integrated_manager_contracts.py
    + [purpose] is prove manager model, readiness, packet, handoff, fault, generated path, fixture runner, no-dispatch, and no-live-effect contracts

  = must: not create any listed file until future implementation activation slices explicitly open it
  = should: route bounded implementation files to GPT-5.3-Codex-Spark after activation boundaries are accepted unless semantics change

