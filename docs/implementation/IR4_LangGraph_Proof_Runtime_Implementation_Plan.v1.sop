  + [allowed_fixture_source_root] is tests/fixtures/sop/ir4_runtime_graph/
  + [allowed_expected_ledger_root] is tests/fixtures/expected/ir4_runtime_graph/
  + [allowed_generated_root] is tests/fixtures/generated/ir4_runtime_graph/
