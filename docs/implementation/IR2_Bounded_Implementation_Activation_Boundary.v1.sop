  + [allowed_stdlib] is sqlite3
  + [allowed_stdlib] is tempfile
  + [allowed_stdlib] is typing
  + [allowed_stdlib] is unittest
  + [external_dependency_set] is empty

  = must: require a future dependency-authorizing slice before adding package dependencies or lockfiles

& [ConfirmedCommandPlan] is the command and verification plan for future implementation slices
  + [baseline_test_command] is python -m unittest discover -s tests
  + [baseline_compile_command] is python -m compileall -q src tests
  + [targeted_contract_test] is python -m unittest tests.test_ir2_parser_projection_contracts
  + [diff_hygiene_command] is git diff --check
  + [generated_output_review] is prove generated outputs are ignored, disposable, and reproducible

  = must: run baseline tests and diff hygiene after every future slice
  = should: run compile check after code slices begin
  = must: run targeted contract tests once tests.test_ir2_parser_projection_contracts exists

