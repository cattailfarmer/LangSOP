  + [future_code_file] is src/langsop/projections/sqlite_schema.py
  + [future_code_file] is src/langsop/projections/sqlite_projection.py
  + [future_code_file] is src/langsop/projections/rebuild.py
  + [future_test_file] is tests/test_ir2_parser_projection_contracts.py

  = must: require deeper reasoning review before adding implementation files outside this inventory
  = must: keep code creation gated until the specific implementation slice opens

