  + [future_code_file] is src/langsop/operations/dry_run.py
  + [future_code_file_role] is build dry-run result records, simulated effect summaries, estimated resource use, predicted side effects, refused effect sets, and non-authority notices without side effects
  + [future_code_file] is src/langsop/operations/resource_safety.py
  + [future_code_file_role] is classify resource targets, risk, blast radius, credential boundaries, network boundaries, rollback routes, approval states, stale states, and revocation states
  + [future_code_file] is src/langsop/operations/refusals.py
  + [future_code_file_role] is classify unsafe operation-like requests into refusal records and SOP-first interrupt contexts
  + [future_code_file] is src/langsop/operations/action_routes.py
  + [future_code_file_role] is classify inspect, simulate, estimate, review, dispatch-like, operation-like, carrier-like, and live-control-like packets without mutating authority
