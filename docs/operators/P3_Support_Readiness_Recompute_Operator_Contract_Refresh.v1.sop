@ [slice_surface] docs/slices/P3_Compiled_SOP_Operator_Contracts_Final_Slices.v1.sop
@ [p3_s03] docs/operators/P3_Signature_Validation_Operator_Contract_Refresh.v1.sop
@ [p3_s03_review] docs/reviews/P3_S03_Completion_Review.v1.sop
@ [p3_common_envelope] docs/operators/P3_Common_Operator_Contract_Envelope_And_Refusal_Semantics.v1.sop
