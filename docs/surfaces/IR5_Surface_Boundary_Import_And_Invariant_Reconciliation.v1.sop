  + [boundary_digest_set_present] is true
  + [reconciled_invariant_set_present] is true
  + [projection_authority_ladder_present] is true
  + [surface_projection_boundary_import_map_present] is true
  + [runtime_proof_handoff_present] is true
  + [operations_safety_handoff_present] is true
  + [generated_output_and_fixture_boundary_present] is true
  + [forbidden_mutation_list_present] is true
  + [downstream_stale_trigger_list_present] is true
  + [executable_ui_code_created] is false
  + [adapter_code_created] is false
  + [fixture_file_created] is false
  + [expected_ledger_created] is false
  + [generated_output_created] is false
  + [dependency_installed] is false
  + [operations_simulator_code_created] is false
  + [operations_control_authorized] is false
  + [live_machine_control_authorized] is false

  = must: accept IR5-S01 only when all checklist items are satisfied
  = must: open IR5-S02 only after this boundary map is reviewed in a completion review
