& [ExpectedOperatorTraceLedgerShape] is the expected operator trace ledger shape
  + [required_field] is fixture_id
  + [required_field] is input_fixture_source_ref
  + [required_field] is expected_operator_contract_id
  + [required_field] is expected_operator_contract_version
  + [required_field] is expected_outcome_kind
  + [required_field] is expected_trace_schema_version
  + [required_field] is expected_trace_status
  + [required_field] is expected_source_ref_state
  + [required_field] is expected_generated_output_ref_state
  + [required_field] is expected_non_authority_warning
  + [required_field] is expected_refusal_reason when outcome is blocked_output or sop_first_interrupt
  + [required_field] is expected_fault_code when outcome is fault_output
  + [required_field] is acceptance_status

  = must: make expected trace facts reviewable without reading generated runtime state as authority
  = must: require explicit expected refusal or fault reason when execution cannot safely succeed

